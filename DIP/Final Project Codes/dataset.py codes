def setup_kaggle(kaggle_json_path: str = None):
    """
    Configure Kaggle API credentials.

    Parameters
    ----------
    kaggle_json_path : str, optional
        Path to kaggle.json file. If None, looks in ~/.kaggle/kaggle.json.

    Usage
    -----
        setup_kaggle("C:/Users/you/Downloads/kaggle.json")
    """
    kaggle_dir = Path.home() / ".kaggle"
    kaggle_dir.mkdir(exist_ok=True)
    dest = kaggle_dir / "kaggle.json"

    if kaggle_json_path:
        import shutil
        shutil.copy(kaggle_json_path, dest)
        dest.chmod(0o600)
        print(f"✅  Kaggle credentials saved to {dest}")
    elif dest.exists():
        print(f"✅  Kaggle credentials already at {dest}")
    else:
        raise FileNotFoundError(
            "kaggle.json not found!\n"
            "1. Go to https://www.kaggle.com\n"
            "2. Profile → Settings → API → Create New Token\n"
            "3. Call setup_kaggle('path/to/kaggle.json')"
        )


def download_dataset(dataset_slug: str = "navoneel/brain-mri-images-for-brain-tumor-detection",
                     dest_dir: Path = RAW_DIR):
    """
    Download a Kaggle dataset and unzip it.

    Parameters
    ----------
    dataset_slug : str
        Kaggle dataset identifier (owner/dataset-name).
    dest_dir : Path
        Where to save and unzip the dataset.
    """
    dest_dir = Path(dest_dir)
    dest_dir.mkdir(parents=True, exist_ok=True)

    import kaggle
    print(f"📥  Downloading: {dataset_slug}")
    kaggle.api.authenticate()
    kaggle.api.dataset_download_files(dataset_slug, path=str(dest_dir), unzip=True)
    print(f"✅  Dataset saved to {dest_dir}")


def manual_unzip(zip_path: str, dest_dir: Path = RAW_DIR):
    """
    Manually unzip a downloaded Kaggle zip file.

    Parameters
    ----------
    zip_path : str
        Path to the .zip file you downloaded manually.
    dest_dir : Path
        Extraction target folder.

    Usage
    -----
        manual_unzip("C:/Downloads/archive.zip")
    """
    dest_dir = Path(dest_dir)
    dest_dir.mkdir(parents=True, exist_ok=True)
    print(f"📦  Unzipping {zip_path} → {dest_dir} …")
    with zipfile.ZipFile(zip_path, "r") as zf:
        zf.extractall(dest_dir)
    print(f"✅  Done. Files saved to {dest_dir}")


