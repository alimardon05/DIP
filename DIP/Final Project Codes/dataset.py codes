def save_data(train, val, test, noisy_dict):
    """Save all arrays to data/ directory."""
    np.save(CLEAN_DIR / "train.npy", train)
    np.save(CLEAN_DIR / "val.npy",   val)
    np.save(CLEAN_DIR / "test.npy",  test)

    for key, arr in noisy_dict.items():
        out = NOISY_DIR / key
        out.mkdir(parents=True, exist_ok=True)
        np.save(out / "test.npy", arr)

    print("✅  All data saved.")


def load_data():
    """Load preprocessed data from data/ directory."""
    train = np.load(CLEAN_DIR / "train.npy")
    val   = np.load(CLEAN_DIR / "val.npy")
    test  = np.load(CLEAN_DIR / "test.npy")

    noisy = {}
    for folder in sorted((NOISY_DIR).iterdir()):
        npy = folder / "test.npy"
        if npy.exists():
            noisy[folder.name] = np.load(npy)

    print(f"✅  Loaded — train:{train.shape}  val:{val.shape}  test:{test.shape}")
    return train, val, test, noisy


